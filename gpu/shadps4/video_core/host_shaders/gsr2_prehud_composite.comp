#version 450
// GoW III: full VideoOut GSR2 scene recovery with a legacy early-preHUD A/B.
// A real capture showed that the early preHUD candidate excludes all the
// foreground characters/effects even though its depth contains those objects.
// The complete-source path avoids that mismatched scene/depth pair; further
// UI-specific masking must be validated independently.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(binding=0) uniform sampler2D InputPreHud;
layout(binding=1) uniform sampler2D InputVideoOut;
layout(binding=2) uniform sampler2D InputGsr2;
layout(binding=3, rgba8) uniform writeonly image2D OutputComposited;
layout(push_constant) uniform Params {
    uvec2 renderSize;
    uvec2 outputSize;
    uint isSrgb;
    float threshold;
    uint completeVideoOut;
} params;

vec3 encodeSrgb(vec3 c) {
    c=clamp(c,0.0,1.0);
    return mix(c*12.92,1.055*pow(c,vec3(1.0/2.4))-0.055,
               vec3(greaterThan(c,vec3(0.0031308))));
}
// Workgroup-shared GLOBAL grade: every 8x8 group independently calculates
// EXACTLY the same grade from the SAME 16 stable screen positions, avoiding
// per-tile brightness jumps at workgroup boundaries.
shared vec3 gradeGain;
shared vec3 gradeBias;
shared float guestFallbackWeight;

ivec2 checkpointPixel(int x,int y) {
    return clamp(ivec2((uint(2*x+1)*params.renderSize.x)/8u,
                       (uint(2*y+1)*params.renderSize.y)/8u),
                 ivec2(0),ivec2(params.renderSize)-1);
}
vec3 applyGrade(vec3 color) {
    return clamp(color*gradeGain+gradeBias,0.0,1.0);
}
// Guest postprocessing can apply a spatially varying tone curve to the ENTIRE
// image. A large pointwise difference is therefore not sufficient evidence of
// HUD/UI. Its high-frequency spatial residual is a stronger discriminator.
vec3 foregroundResidual(ivec2 p) {
    p=clamp(p,ivec2(0),ivec2(params.renderSize)-1);
    vec3 before=applyGrade(texelFetch(InputPreHud,p,0).rgb);
    vec3 after=texelFetch(InputVideoOut,p,0).rgb;
    return after-before;
}
float maxChannel(vec3 v) {
    v=abs(v);
    return max(v.r,max(v.g,v.b));
}
void main() {
    // The 2026-10-29 raw capture proved that the early LDR target contains
    // scenery, but misses Kratos, combat effects and enemies. The complete
    // guest VideoOut contains the actual visible world. Reproject that FULL
    // image, not the stale background plus post-hoc spatial character overlay.
    // Both image and depth are from this canonical flip. UI may still need a
    // real HUD-stage mask; no shader-hash heuristics are silently invented.
    if (params.completeVideoOut != 0u) {
        ivec2 px=ivec2(gl_GlobalInvocationID.xy);
        if(any(greaterThanEqual(uvec2(px),params.outputSize)))return;
        vec2 uv=(vec2(px)+0.5)/vec2(params.outputSize);
        vec3 scene=textureLod(InputGsr2,uv,0.0).rgb;
        vec3 outColor=params.isSrgb!=0u ? encodeSrgb(scene) : clamp(scene,0.0,1.0);
        imageStore(OutputComposited,px,vec4(outColor,1.0));
        return;
    }
    if (gl_LocalInvocationIndex == 0u) {
        // The PS4 display-copy commonly changes brightness and color over
        // MOST of the screen, even though the scene's geometry is identical.
        // The previous 5/16 raw-difference threshold misclassified a normal
        // grade as a different scene, switching the entire screen between
        // Qualcomm history and raw VideoOut from one flip to the next.
        // Fit a bounded affine grade in LINEAR light, then measure residual
        // structural mismatch AFTER removing the global brightness change.
        vec3 sumX=vec3(0.0),sumY=vec3(0.0);
        vec3 sumXX=vec3(0.0),sumXY=vec3(0.0);
        float kept=0.0;
        for(int y=0;y<4;++y) for(int x=0;x<4;++x) {
            ivec2 p=checkpointPixel(x,y);
            vec3 a=texelFetch(InputPreHud,p,0).rgb;
            vec3 b=texelFetch(InputVideoOut,p,0).rgb;
            // Opaque HUD elements and abrupt scene substitutions are NOT
            // global color grades. Exclude these high-disagreement outliers
            // from the fit, otherwise two white glyph samples can skew ALL
            // scene colors and make the fallback weight oscillate.
            vec3 d=abs(a-b);
            if(max(d.r,max(d.g,d.b))>0.55)continue;
            sumX+=a;sumY+=b;sumXX+=a*a;sumXY+=a*b;
            kept+=1.0;
        }
        float rcpCount=1.0/max(kept,1.0);
        vec3 meanX=sumX*rcpCount,meanY=sumY*rcpCount;
        vec3 variance=max(sumXX*rcpCount-meanX*meanX,vec3(0.0));
        vec3 covariance=sumXY*rcpCount-meanX*meanY;
        vec3 fitted=clamp(covariance/max(variance,vec3(0.00002)),
                          vec3(0.55),vec3(2.25));
        gradeGain=mix(vec3(1.0),fitted,
                      vec3(greaterThan(variance,vec3(0.00002))));
        gradeBias=clamp(meanY-gradeGain*meanX,vec3(-0.28),vec3(0.28));

        float bad=0.0;
        for(int y=0;y<4;++y) for(int x=0;x<4;++x) {
            ivec2 p=checkpointPixel(x,y);
            vec3 estimated=applyGrade(texelFetch(InputPreHud,p,0).rgb);
            vec3 observed=texelFetch(InputVideoOut,p,0).rgb;
            vec3 delta=abs(estimated-observed);
            bad+=float(max(delta.r,max(delta.g,delta.b))>0.12);
        }
        // Sparse checkpoints cannot classify an entire image as unrelated
        // after 3/16 tone-map outliers: in the 215958 scene this disabled
        // Qualcomm across most pixels. Only obvious widespread disagreement
        // is allowed to replace the whole reconstructed scene.
        guestFallbackWeight=kept<8.0 ? 1.0
                                      : smoothstep(12.0,15.0,bad);
    }
    barrier();
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(uvec2(pixel),params.outputSize)))return;
    vec2 uv=(vec2(pixel)+0.5)/vec2(params.outputSize);
    ivec2 low=clamp(ivec2(uv*vec2(params.renderSize)),
                    ivec2(0),ivec2(params.renderSize)-1);
    vec3 residual=foregroundResidual(low);
    vec3 neighborhood=vec3(0.0);
    for(int y=-1;y<=1;++y)
        for(int x=-1;x<=1;++x)
            neighborhood+=foregroundResidual(low+ivec2(x,y));
    neighborhood*=1.0/9.0;
    // A nonlinear brightness correction leaves coherent, smooth residuals;
    // new HUD glyphs and panels introduce local edges in the residual.
    // Also preserve very large opaque overlays even when their interiors
    // are flat (no local edge).
    float residualEdge=maxChannel(residual-neighborhood);
    float opaqueDifference=maxChannel(residual);

    vec3 guest=textureLod(InputVideoOut,uv,0.0).rgb;
    vec3 gsrScene=textureLod(InputGsr2,uv,0.0).rgb;
    vec3 before=textureLod(InputPreHud,uv,0.0).rgb;
    // Reconstruct in the original display color space. Retain localized
    // nonlinear color corrections as a same-frame residual AFTER GSR2,
    // never in the temporal scene history.
    // ZIP (12): the 16-checkpoint fitted grade oscillated violently as
    // combat effects crossed its sparse sample sites (red gain 1.34 -> 0.55
    // in successive camera-valid, jitter=0 temporal frames). Algebraically,
    // the previous expression was guest + gradeGain*(gsrScene-before), so
    // moving effects modulated the ENTIRE temporal reconstruction each
    // frame. Keep the fitted grade ONLY to distinguish postprocessing from
    // genuine HUD edges; never apply that unstable global gain to temporal
    // scene detail. All three samplers are in linear light.
    vec3 restored=clamp(guest+(gsrScene-before),0.0,1.0);
    float overlayWeight=max(smoothstep(0.06,0.16,residualEdge),
                            smoothstep(0.28,0.65,opaqueDifference));
    float guestWeight=max(overlayWeight,guestFallbackWeight);
    vec3 result=mix(restored,guest,guestWeight);
    if(params.isSrgb!=0u)result=encodeSrgb(result);
    imageStore(OutputComposited,pixel,vec4(result,1.0));
}
