#version 450
// GoW III: reconstruct the pre-HUD scene with GSR2, then restore PS4 UI drawn
// into the guest VideoOut buffer. Never put UI pixels in GSR temporal history.
// The GPU compares two snapshots from the SAME guest frame: the last LDR scene
// before the first display-copy draw, and the finished VideoOut color.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(binding=0) uniform sampler2D InputPreHud;
layout(binding=1) uniform sampler2D InputVideoOut;
layout(binding=2) uniform sampler2D InputGsr2;
layout(binding=3, rgba8) uniform writeonly image2D OutputComposited;
layout(push_constant) uniform Params {
    uvec2 renderSize;
    uvec2 outputSize;
    uint isSrgb;
    float threshold;
} params;

vec3 encodeSrgb(vec3 c) {
    c=clamp(c,0.0,1.0);
    return mix(c*12.92,1.055*pow(c,vec3(1.0/2.4))-0.055,
               vec3(greaterThan(c,vec3(0.0031308))));
}
float foregroundDifference(ivec2 p) {
    p=clamp(p,ivec2(0),ivec2(params.renderSize)-1);
    vec3 before=texelFetch(InputPreHud,p,0).rgb;
    vec3 after=texelFetch(InputVideoOut,p,0).rgb;
    return max(max(abs(before.r-after.r),abs(before.g-after.g)),abs(before.b-after.b));
}
// A non-matching scene target must NEVER be composited over the real guest
// output. Sample 16 well-distributed regions first. These samples belong to
// the same canonical VideoOut flip, not an unrelated candidate readback.
shared uint incompatibleScene;
void main() {
    if (gl_LocalInvocationIndex == 0u) {
        uint different=0u;
        for (int y=0; y<4; ++y) {
            for (int x=0; x<4; ++x) {
                ivec2 checkpoint=ivec2(
                    (uint(2*x+1)*params.renderSize.x)/8u,
                    (uint(2*y+1)*params.renderSize.y)/8u);
                different+=uint(foregroundDifference(checkpoint)>params.threshold);
            }
        }
        // A fullscreen difference signals a display-copy/tonemap/menu, not a
        // handful of HUD glyphs. Present the original guest without mixing
        // its pixels with the temporal history of a different scene.
        // The old 12/16 threshold missed 7200's full-screen color-pass
        // mismatch (7/16 sampled sites changed): it then mixed whole
        // regions of GSR history and raw VideoOut in one frame, appearing
        // as screen-wide alternating/corrupted patches on the device.
        // At >=5/16 geographically distributed sites, fall back coherently
        // for this flip. A few HUD glyphs may trigger a safe full-frame
        // fallback, never a spatially torn composite.
        incompatibleScene=uint(different>=5u);
    }
    barrier();
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(uvec2(pixel),params.outputSize))) return;
    vec2 uv=(vec2(pixel)+0.5)/vec2(params.outputSize);
    ivec2 low=clamp(ivec2(uv*vec2(params.renderSize)),ivec2(0),ivec2(params.renderSize)-1);
    // Dilate changed regions by one source pixel: text outlines and HUD masks
    // must not inherit the jittered history of the background.
    float changed=0.0;
    for(int y=-1;y<=1;++y)
      for(int x=-1;x<=1;++x)
        changed=max(changed,foregroundDifference(low+ivec2(x,y)));
    // Stable clear colors, menus, or unverified postprocessing always have
    // a safe guest fallback rather than blending unrelated temporal history.
    vec3 guest=textureLod(InputVideoOut,uv,0.0).rgb;
    vec3 scene=textureLod(InputGsr2,uv,0.0).rgb;
    // Even when the guest has not drawn any text/HUD, its display-copy pass
    // can apply a full-frame color transform. A binary scene/HUD mask drops
    // those transforms and changes the game's original appearance (observed
    // in the same-flip 9600 preHUD/VideoOut/final readback).
    //
    // Both guest and preHUD are sampled in the SAME linear-light space here
    // (sRGB decoding happens at the Vulkan sampler). Apply that current-frame
    // residual AFTER Qualcomm's scene-only temporal history. No postprocess
    // or HUD signal is fed back to GSR2.
    vec3 before=textureLod(InputPreHud,uv,0.0).rgb;
    vec3 restored=clamp(scene + (guest-before),0.0,1.0);
    // Significant local differences are masks, text and foreground overlays.
    // Keep their exact guest color without exposing them to scene reprojection.
    // Do not switch hard between two full-frame pipelines at every moving
    // HUD/color-grade boundary. Smooth the pixel mask after its 3x3 dilation
    // while retaining exact original guest pixels for opaque overlays.
    float overlayWeight=smoothstep(params.threshold*0.5,
                                   params.threshold*2.0,changed);
    vec3 result=incompatibleScene!=0u ? guest
                                      : mix(restored,guest,overlayWeight);
    if(params.isSrgb!=0u) result=encodeSrgb(result);
    imageStore(OutputComposited,pixel,vec4(result,1.0));
}
