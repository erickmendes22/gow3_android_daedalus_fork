{
  "schema_version": 1,
  "profile": "debug",
  "application_id": "com.gow3.android",
  "java_package": "ro.cobrabm.fexdroid",
  "target_sdk": 28,
  "abi": "arm64-v8a",
  "files_dir": "/data/user/0/{application_id}/files",
  "runtime_root": "rootfs",
  "port_root": "gow3port",
  "port_arch_root": "gow3port/arm64",
  "home_root": "home",
  "top_level_roots": ["rootfs", "gow3port", "home"],
  "required_directories": ["home/gow3port"],
  "loader": "rootfs/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1",
  "loader_strategy": "explicit-loader-when-PT_INTERP-slot-cannot-fit",
  "entrypoints": [
    {"path": "rootfs/usr/libexec/fxshmd", "owner": "java", "kind": "arm64-elf", "launch_via_loader": true, "args": ["--dir", "rootfs/tmp/.fxshm"]},
    {"path": "rootfs/usr/bin/Xvfb", "owner": "java", "kind": "arm64-elf", "launch_via_loader": true, "args": [":0", "-screen", "0", "1280x720x24", "-shmem", "-ac", "-nolisten", "tcp", "-pn"]},
    {"path": "rootfs/usr/bin/python3.13", "owner": "run-gow3.sh", "kind": "arm64-elf", "launch_via_loader": true, "args": ["gow3port/scripts/prepare.py"]},
    {"path": "gow3port/arm64/bin/gow3-probe", "owner": "run-gow3.sh", "kind": "arm64-elf", "launch_via_loader": true, "args": ["--vulkan-only", "--cpu-only"]},
    {"path": "gow3port/arm64/bin/kgsl-chip-id", "owner": "run-gow3.sh", "kind": "arm64-elf", "launch_via_loader": true, "args": []},
    {"path": "rootfs/usr/bin/FEX", "owner": "gow3-probe", "kind": "arm64-elf", "launch_via_loader": true, "args": []},
    {"path": "gow3port/run-gow3.sh", "owner": "java", "kind": "shell", "launch_via_loader": false, "args": ["game", "cpu", "check", "vulkan"]}
  ],
  "required_paths": [
    {"path": "rootfs/usr/bin/Xvfb", "type": "executable"},
    {"path": "rootfs/usr/bin/sh", "type": "executable"},
    {"path": "rootfs/usr/libexec/fxshmd", "type": "executable"},
    {"path": "rootfs/usr/bin/FEX", "type": "executable"},
    {"path": "rootfs/usr/bin/python3.13", "type": "executable"},
    {"path": "rootfs/usr/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1", "type": "loader"},
    {"path": "gow3port/arm64/bin/gow3-probe", "type": "executable"},
    {"path": "gow3port/arm64/bin/kgsl-chip-id", "type": "executable"},
    {"path": "gow3port/arm64/lib/libgow3cpu.so", "type": "shared-library"},
    {"path": "gow3port/arm64/lib/libgow3gpu.so", "type": "shared-library"},
    {"path": "rootfs/usr/lib/aarch64-linux-gnu/libvulkan_freedreno.so", "type": "shared-library"},
    {"path": "rootfs/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json", "type": "data"},
    {"path": "rootfs/usr/lib/aarch64-linux-gnu/libvulkan_freedreno_gen8.so", "type": "shared-library"},
    {"path": "rootfs/usr/share/vulkan/icd.d/freedreno_gen8_icd.aarch64.json", "type": "data"},
    {"path": "gow3port/run-gow3.sh", "type": "executable"},
    {"path": "gow3port/scripts/launch_env.py", "type": "data"},
    {"path": "gow3port/scripts/patches.py", "type": "data"},
    {"path": "gow3port/scripts/content_profile.py", "type": "data"},
    {"path": "gow3port/scripts/graphics_options.py", "type": "data"},
    {"path": "gow3port/scripts/game_update.py", "type": "data"},
    {"path": "gow3port/scripts/link_libc.py", "type": "data"},
    {"path": "gow3port/scripts/link_modules.py", "type": "data"},
    {"path": "gow3port/scripts/mods.py", "type": "data"},
    {"path": "gow3port/scripts/prepare.py", "type": "data"},
    {"path": "gow3port/scripts/prepare_game.py", "type": "data"},
    {"path": "gow3port/scripts/save_backup.py", "type": "data"},
    {"path": "gow3port/patches/God_of_War_III_Remastered.xml", "type": "data"},
    {"path": "gow3port/gow3-fex-compatible.json", "type": "data"},
    {"path": "gow3port/gow3.default.ini", "type": "data"}
  ],
  "environment": {
    "FXD_FILES": "{files_dir}",
    "FXD_ROOT": "{files_dir}/rootfs",
    "LD_LIBRARY_PATH": "{files_dir}/gow3port/arm64/lib:{files_dir}/rootfs/usr/lib/aarch64-linux-gnu:{files_dir}/rootfs/usr/lib/aarch64-linux-gnu/pulseaudio:{files_dir}/rootfs/usr/lib",
    "PATH": "{files_dir}/rootfs/usr/bin:{files_dir}/rootfs/bin:/system/bin",
    "TMPDIR": "{files_dir}/rootfs/tmp",
    "XDG_RUNTIME_DIR": "{files_dir}/rootfs/tmp"
  },
  "turnip_variants": ["rootfs/usr/lib/aarch64-linux-gnu/libvulkan_freedreno.so", "rootfs/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json", "rootfs/usr/lib/aarch64-linux-gnu/libvulkan_freedreno_gen8.so", "rootfs/usr/share/vulkan/icd.d/freedreno_gen8_icd.aarch64.json"],
  "forbidden_archive_fragments": ["com.gp.android", "eboot.bin", "eboot.elf", "sce_module", "sce_sys", "boot-linked.bin", "save/"],
  "legacy_layout": ["gow3port/bin", "gow3port/lib"],
  "game_content_policy": "external-only",
  "profile_note": "Debug payload reuses local Turnip, Gen8 Turnip and LSFG inputs without building them; Steam libraries are also reused when present in .local-deps/android/steam-libs."
}
